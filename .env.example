# Application
PROJECT_NAME="CampusBite API"
ENVIRONMENT="development"
DEBUG=True

# Security (Argon2 / JWT)
JWT_SECRET_KEY="replace_with_a_secure_32_character_hex_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Async SQLite inside Docker persistent volume)
DATABASE_URL="sqlite+aiosqlite:////app/data/campusbite.db"

# Applied AI (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"

# Customer order-history advisor (OpenAI)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"