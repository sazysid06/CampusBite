# Application
PROJECT_NAME="CampusBite API"
ENVIRONMENT="development"
DEBUG=True

# Security (Argon2 / JWT)
JWT_SECRET_KEY="replace_with_a_secure_32_character_hex_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Async SQLite)
DATABASE_URL="sqlite+aiosqlite:///./campusbite.db"

# Applied AI (Google Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"